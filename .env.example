# ─────────────────────────────────────────────────────────────────────────────
#  AG2 · AG-UI external-docs harness
#
#  Copy to `.env` and fill in. Names come from the doc pages themselves.
# ─────────────────────────────────────────────────────────────────────────────

# The CopilotKit Quickstart's step 1: `export OPENAI_API_KEY="your_openai_api_key"`.
# `ag2.config.OpenAIConfig` reads it.
OPENAI_API_KEY=sk-...

# The AG-UI index page's sample uses `OpenAIConfig(model="gpt-5.4-mini")`, and so
# does the linked starter. Override to try another model without editing a
# snippet.
OPENAI_MODEL=gpt-5.4-mini

# ── Ports ────────────────────────────────────────────────────────────────────
# 8008 is the Quickstart's own: "the starter backend mounts the AG-UI endpoint
# at /chat and runs on port 8008". The published `route.ts` hardcodes
# `http://localhost:8008/chat`, so moving this means editing a doc snippet.
AG2_PORT=8008

# 3301, not the doc's 3000. Eleven sibling repos in this workspace default to
# 3000; a collision makes the recorder film whichever app answered. This is a
# harness choice — `next dev --port` appears in no published snippet.
FRONTEND_PORT=3301
FRONTEND_URL=http://localhost:3301
